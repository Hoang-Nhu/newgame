        function renderRoleSelectors() {
          const buildGrid = (container, selectedId, onSelect) => {
            if (!container) return;
            container.innerHTML = '';
            for (const key of Object.keys(ROLE_CONFIGS)) {
              const cfg = ROLE_CONFIGS[key];
              const active = key === selectedId;
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = `p-2.5 rounded-2xl border text-left transition cursor-pointer ${
                active
                  ? 'bg-amber-400/20 border-amber-300 text-white shadow-lg'
                  : 'bg-slate-900/70 border-slate-700/80 text-slate-300 hover:bg-slate-800'
              }`;
              btn.innerHTML = `<div class="text-lg">${cfg.icon}</div><div class="text-xs font-extrabold mt-0.5">${cfg.name}</div>`;
              btn.addEventListener('click', () => onSelect(key));
              container.appendChild(btn);
            }
          };

          const pGrid = document.getElementById('player-role-grid');
          const eGrid = document.getElementById('enemy-role-grid');
          buildGrid(pGrid, state.playerRole, (role) => {
            state.playerRole = role;
            renderRoleSelectors();
          });
          buildGrid(eGrid, state.enemyRole, (role) => {
            state.enemyRole = role;
            renderRoleSelectors();
          });
        }

        // Controls & Event Listeners
        function bindHoldButton(btnEl, kind) {
          if (!btnEl) return;
          btnEl.addEventListener('pointerdown', (e) => {
            e.preventDefault();
            e.stopPropagation();
            startHoldPreview(kind, e.clientX, e.clientY);
          });
        }

        bindHoldButton(ui.btnAttack, 'basic');
        bindHoldButton(ui.btnSkill1, 'skill1');
        bindHoldButton(ui.btnSkill2, 'skill2');
        bindHoldButton(ui.btnSkillCc, 'skillcc');
        bindHoldButton(ui.btnSkillUlt, 'ult');
        bindHoldButton(ui.btnBlink, 'blink');

        window.addEventListener('pointermove', (e) => {
          if (telegraph.active) {
            moveHoldPreview(e.clientX, e.clientY);
            return;
          }
          if (state.joy.active && e.pointerId === state.joy.pointerId && ui.joystickPad && ui.joystickKnob) {
            const rect = ui.joystickPad.getBoundingClientRect();
            const cx = rect.left + rect.width * 0.5;
            const cy = rect.top + rect.height * 0.5;
            const maxR = rect.width * 0.38;
            let dx = e.clientX - cx;
            let dy = e.clientY - cy;
            const dist = Math.hypot(dx, dy);
            if (dist > maxR && dist > 0.001) {
              dx = (dx / dist) * maxR;
              dy = (dy / dist) * maxR;
            }
            state.joy.dx = dx / Math.max(1, maxR);
            state.joy.dz = dy / Math.max(1, maxR);
            ui.joystickKnob.style.transform = `translate(${dx}px, ${dy}px)`;
            return;
          }
          if (state.aimDrag.active && e.pointerId === state.aimDrag.pointerId && state.cameraMode === 'free3d') {
            const dx = e.clientX - state.aimDrag.lastX;
            const dy = e.clientY - state.aimDrag.lastY;
            state.aimDrag.lastX = e.clientX;
            state.aimDrag.lastY = e.clientY;
            state.cam.orbitYaw = normalizeAngle(state.cam.orbitYaw - dx * 0.0075);
            state.cam.orbitPitch = clamp(state.cam.orbitPitch + dy * 0.006, 0.25, 1.25);
          }
        });

        window.addEventListener('pointerup', (e) => {
          if (telegraph.active) {
            releaseHoldPreview();
          }
          if (state.joy.active && e.pointerId === state.joy.pointerId) {
            state.joy.active = false;
            state.joy.pointerId = null;
            state.joy.dx = 0;
            state.joy.dz = 0;
            if (ui.joystickKnob) ui.joystickKnob.style.transform = 'translate(0px, 0px)';
          }
          if (state.aimDrag.active && e.pointerId === state.aimDrag.pointerId) {
            state.aimDrag.active = false;
            state.aimDrag.pointerId = null;
          }
        });

        window.addEventListener('pointercancel', () => {
          if (telegraph.active) releaseHoldPreview();
          state.joy.active = false;
          state.joy.pointerId = null;
          state.joy.dx = 0;
          state.joy.dz = 0;
          if (ui.joystickKnob) ui.joystickKnob.style.transform = 'translate(0px, 0px)';
          state.aimDrag.active = false;
          state.aimDrag.pointerId = null;
        });

        if (ui.joystickPad) {
          ui.joystickPad.addEventListener('pointerdown', (e) => {
            e.preventDefault();
            e.stopPropagation();
            state.joy.active = true;
            state.joy.pointerId = e.pointerId;
          });
        }

        canvas.addEventListener('pointerdown', (e) => {
          if (state.cameraMode === 'free3d') {
            state.aimDrag.active = true;
            state.aimDrag.pointerId = e.pointerId;
            state.aimDrag.lastX = e.clientX;
            state.aimDrag.lastY = e.clientY;
          }
        });

        window.addEventListener('keydown', (e) => {
          state.keys.add(e.code);
          if (state.matchOver || !state.player || state.player.isDead) return;
          if (e.code === 'Digit1' || e.code === 'KeyQ') beginCastWindup(state.player, 'skill1', state.player.yaw, null);
          else if (e.code === 'Digit2' || e.code === 'KeyE') beginCastWindup(state.player, 'skill2', state.player.yaw, null);
          else if (e.code === 'Digit3' || e.code === 'KeyR') beginCastWindup(state.player, 'skillcc', state.player.yaw, null);
          else if (e.code === 'Digit4' || e.code === 'KeyF') beginCastWindup(state.player, 'ult', state.player.yaw, null);
          else if (e.code === 'Space') {
            e.preventDefault();
            triggerBlink(state.player);
          }
        });

        window.addEventListener('keyup', (e) => {
          state.keys.delete(e.code);
        });

        if (ui.btnCameraMode) {
          ui.btnCameraMode.addEventListener('click', () => {
            const order = ['free3d', 'overview', 'follow'];
            const labels = {
              free3d: '🎥 Xoay 3D',
              overview: '🔭 Toàn Cảnh',
              follow: '🎯 Ghim Mặt'
            };
            const next = order[(order.indexOf(state.cameraMode) + 1) % order.length];
            state.cameraMode = next;
            ui.btnCameraMode.textContent = labels[next];
          });
        }

        if (ui.btnFullscreen) {
          ui.btnFullscreen.addEventListener('click', () => {
            try {
              if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(() => {
                  if (state.player) spawnCallout(state.player.pos, 'Khung xem trước hạn chế Fullscreen', '#fde047');
                });
              } else if (document.fullscreenElement && document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
              }
            } catch (_) {
              if (state.player) spawnCallout(state.player.pos, 'Không thể bật toàn màn hình', '#fde047');
            }
          });
        }

        if (ui.btnOpenMatchup) {
          ui.btnOpenMatchup.addEventListener('click', () => {
            renderRoleSelectors();
            openMatchupModal();
          });
        }

        if (ui.btnCloseMatchup) {
          ui.btnCloseMatchup.addEventListener('click', closeMatchupModal);
        }

        if (ui.btnStartMatchup) {
          ui.btnStartMatchup.addEventListener('click', () => {
            closeMatchupModal();
            setGameOverModalVisible(false);
            startMatch(state.playerRole, state.enemyRole);
          });
        }

        const handleRestartMatch = () => {
          setGameOverModalVisible(false);
          closeMatchupModal();
          startMatch(state.playerRole, state.enemyRole);
        };

        if (ui.btnReset) ui.btnReset.addEventListener('click', handleRestartMatch);
        if (ui.btnRematch) ui.btnRematch.addEventListener('click', handleRestartMatch);

        if (ui.btnChooseNewTarget) {
          ui.btnChooseNewTarget.addEventListener('click', () => {
            setGameOverModalVisible(false);
            renderRoleSelectors();
            openMatchupModal();
          });
        }

        window.addEventListener('resize', () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        });

        try {
          startMatch(state.playerRole, state.enemyRole);

          let lastTime = performance.now();
          function animate(now) {
            requestAnimationFrame(animate);
            const safeNow = typeof now === 'number' && !Number.isNaN(now) ? now : performance.now();
            const rawDt = (safeNow - lastTime) / 1000;
            lastTime = safeNow;
            const dt = clamp(rawDt > 0 ? rawDt : 0.016, 0.001, 0.05);

            try {
              if (state.allFighters.length > 0) {
                updateFighters(dt);
                updateCombatObjects(dt);
                updateTelegraphVisual();
                updateCamera(dt);
                updateHud(false);
              }
              renderer.render(scene, camera);
            } catch (err) {
              console.error('Lỗi vòng lặp game:', err);
            }
          }
          requestAnimationFrame(animate);
        } catch (loopBootErr) {
          console.error('Lỗi khởi chạy vòng lặp:', loopBootErr);
          showErrorOverlay(loopBootErr && loopBootErr.message ? loopBootErr.message : String(loopBootErr));
        }
        } catch (bootErr) {
          console.error('Lỗi khởi chạy game:', bootErr);
          showErrorOverlay(bootErr && bootErr.message ? bootErr.message : String(bootErr));
        }
      }

      loadThreeWithFallback(THREE_CDNS)
        .then((THREE) => startGame(THREE))
        .catch((err) => showErrorOverlay(err && err.message ? err.message : String(err)));
    })();
  </script>
</body>
</html>