<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Đại Chiến Sinh Tồn 3D</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #070d19;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: #f8fafc;
      touch-action: none;
    }
    #game-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .glass-panel {
      background: rgba(10, 17, 32, 0.72);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(148, 163, 184, 0.22);
    }
    .moba-btn {
      transition: transform 0.08s ease, filter 0.12s ease, box-shadow 0.12s ease;
      touch-action: none;
    }
    .moba-btn:active {
      transform: scale(0.92);
      filter: brightness(1.12);
    }
    .callout-item {
      position: fixed;
      transform: translate(-50%, -100%);
      pointer-events: none;
      font-weight: 900;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.92);
      white-space: nowrap;
      z-index: 25;
    }
  </style>
</head>
<body>
  <canvas id="game-canvas"></canvas>
  <div id="callout-layer" class="fixed inset-0 pointer-events-none z-20 overflow-hidden"></div>

  <!-- Top HUD -->
  <header class="fixed top-0 inset-x-0 z-30 p-2 sm:p-3 flex items-start justify-between gap-2 pointer-events-none">
    <!-- Player Status -->
    <div class="glass-panel pointer-events-auto rounded-2xl px-2.5 py-2 sm:px-3.5 sm:py-2.5 w-[41%] sm:w-64 shadow-xl">
      <div class="flex items-center justify-between gap-1 mb-1">
        <span id="player-role-badge" class="text-[11px] sm:text-xs font-extrabold text-emerald-300 truncate">🏹 Cung Thủ</span>
        <span id="player-hp-text" class="text-[10px] sm:text-xs font-mono font-bold text-slate-200">120/120</span>
      </div>
      <div class="w-full h-2 sm:h-2.5 rounded-full bg-slate-800/95 overflow-hidden border border-white/10">
        <div id="player-hp-bar" class="h-full bg-gradient-to-r from-emerald-500 to-lime-400 transition-all duration-100" style="width: 100%;"></div>
      </div>
      <div class="mt-1.5 flex items-center justify-between gap-1">
        <div id="player-lives" class="flex items-center gap-0.5 text-xs sm:text-sm">❤️❤️❤️</div>
        <div id="player-status-tags" class="flex items-center gap-1 flex-wrap justify-end"></div>
      </div>
    </div>

    <!-- Center Matchup & Utility Buttons -->
    <div class="flex flex-col items-center gap-1.5 pointer-events-auto">
      <button
        id="btn-open-matchup"
        type="button"
        class="glass-panel rounded-full px-3 py-1.5 sm:px-4 sm:py-2 text-[11px] sm:text-xs font-extrabold text-amber-300 hover:text-amber-200 border border-amber-400/35 shadow-lg flex items-center gap-1.5 cursor-pointer"
      >
        <span>⚔️</span>
        <span id="matchup-summary">Sinh Tồn (7/7 sống)</span>
      </button>
      <div class="flex items-center gap-1 sm:gap-1.5 flex-wrap justify-center">
        <button
          id="btn-camera-mode"
          type="button"
          class="glass-panel rounded-full px-2.5 py-1 text-[10px] sm:text-[11px] font-bold text-sky-200 hover:bg-slate-800/80 cursor-pointer"
        >
          🎥 Xoay 3D
        </button>
        <button
          id="btn-fullscreen"
          type="button"
          class="glass-panel rounded-full px-2.5 py-1 text-[10px] sm:text-[11px] font-bold text-amber-200 hover:bg-slate-800/80 cursor-pointer"
        >
          ⛶ Full
        </button>
        <button
          id="btn-reset"
          type="button"
          class="glass-panel rounded-full px-2.5 py-1 text-[10px] sm:text-[11px] font-bold text-slate-200 hover:bg-slate-800/80 cursor-pointer"
        >
          ↻ Đấu lại
        </button>
      </div>
    </div>

    <!-- Target / AI Status -->
    <div class="glass-panel pointer-events-auto rounded-2xl px-2.5 py-2 sm:px-3.5 sm:py-2.5 w-[41%] sm:w-64 shadow-xl">
      <div class="flex items-center justify-between gap-1 mb-1">
        <span id="enemy-hp-text" class="text-[10px] sm:text-xs font-mono font-bold text-slate-200">120/120</span>
        <span id="enemy-role-badge" class="text-[11px] sm:text-xs font-extrabold text-rose-300 truncate">🏹 Cung Thủ AI #1</span>
      </div>
      <div class="w-full h-2 sm:h-2.5 rounded-full bg-slate-800/95 overflow-hidden border border-white/10">
        <div id="enemy-hp-bar" class="h-full bg-gradient-to-l from-rose-500 to-orange-400 transition-all duration-100 ml-auto" style="width: 100%;"></div>
      </div>
      <div class="mt-1.5 flex items-center justify-between gap-1">
        <div id="enemy-status-tags" class="flex items-center gap-1 flex-wrap"></div>
        <div id="enemy-lives" class="flex items-center gap-0.5 text-xs sm:text-sm ml-auto">💔💔💔</div>
      </div>
    </div>
  </header>

  <!-- Bottom Controls: Left Joystick + Right MOBA Skill Cluster -->
  <footer class="fixed bottom-0 inset-x-0 z-30 p-3 sm:p-5 flex items-end justify-between pointer-events-none">
    <!-- Virtual Joystick -->
    <div class="pointer-events-auto flex flex-col items-center gap-1.5">
      <div
        id="joystick-pad"
        class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full glass-panel border-2 border-sky-400/35 shadow-2xl flex items-center justify-center"
      >
        <div class="w-12 h-12 rounded-full border border-dashed border-white/20 pointer-events-none"></div>
        <div
          id="joystick-knob"
          class="w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-gradient-to-br from-sky-400 to-indigo-600 border-2 border-white/75 shadow-lg pointer-events-none"
          style="transform: translate(0px, 0px);"
        ></div>
      </div>
      <span class="text-[10px] text-slate-300/85 font-semibold hidden sm:inline">WASD / Joystick · Kéo màn hình xoay 3D</span>
    </div>

    <!-- Bottom-Right Skill Cluster: Skill 1, Skill 2, CC Skill, Ultimate + Blink + Main Attack -->
    <div class="pointer-events-auto flex flex-col items-end gap-2">
      <div class="flex items-end gap-2.5">
        <div class="flex flex-col items-end gap-2">
          <div class="flex items-center gap-1.5 flex-wrap justify-end max-w-[275px] sm:max-w-none">
            <button
              id="btn-skill-1"
              type="button"
              class="moba-btn relative w-14 h-12 sm:w-16 sm:h-14 rounded-full bg-gradient-to-br from-amber-400/95 to-orange-600/95 text-slate-950 font-extrabold text-[9px] sm:text-[11px] border-2 border-amber-100/75 shadow-lg flex flex-col items-center justify-center cursor-pointer overflow-hidden px-1"
            >
              <div id="skill1-cd-fill" class="absolute inset-x-0 bottom-0 bg-slate-950/70 pointer-events-none" style="height: 0%;"></div>
              <span id="skill1-label" class="relative z-10 leading-tight text-center">10 Tiễn</span>
              <span id="skill1-cd-text" class="relative z-10 text-[8px] font-mono opacity-90">1 / Q</span>
            </button>

            <button
              id="btn-skill-2"
              type="button"
              class="moba-btn relative w-14 h-12 sm:w-16 sm:h-14 rounded-full bg-gradient-to-br from-fuchsia-500/95 to-purple-700/95 text-white font-extrabold text-[9px] sm:text-[11px] border-2 border-fuchsia-200/75 shadow-lg flex flex-col items-center justify-center cursor-pointer overflow-hidden px-1"
            >
              <div id="skill2-cd-fill" class="absolute inset-x-0 bottom-0 bg-slate-950/70 pointer-events-none" style="height: 0%;"></div>
              <span id="skill2-label" class="relative z-10 leading-tight text-center">Tên Xuyên</span>
              <span id="skill2-cd-text" class="relative z-10 text-[8px] font-mono opacity-90">2 / E</span>
            </button>

            <button
              id="btn-skill-cc"
              type="button"
              class="moba-btn relative w-14 h-12 sm:w-16 sm:h-14 rounded-full bg-gradient-to-br from-rose-500/95 to-amber-500/95 text-slate-950 font-black text-[9px] sm:text-[11px] border-2 border-rose-100/80 shadow-lg flex flex-col items-center justify-center cursor-pointer overflow-hidden px-1"
            >
              <div id="skillcc-cd-fill" class="absolute inset-x-0 bottom-0 bg-slate-950/70 pointer-events-none" style="height: 0%;"></div>
              <span id="skillcc-label" class="relative z-10 leading-tight text-center">Tên Choáng</span>
              <span id="skillcc-cd-text" class="relative z-10 text-[8px] font-mono opacity-95">3 / R</span>
            </button>

            <button
              id="btn-skill-ult"
              type="button"
              class="moba-btn relative w-15 h-13 sm:w-17 sm:h-15 rounded-full bg-gradient-to-br from-yellow-300 via-amber-500 to-red-600 text-slate-950 font-black text-[9px] sm:text-[11px] border-2 border-yellow-100 shadow-xl flex flex-col items-center justify-center cursor-pointer overflow-hidden px-1"
            >
              <div id="skillult-cd-fill" class="absolute inset-x-0 bottom-0 bg-slate-950/75 pointer-events-none" style="height: 0%;"></div>
              <span id="skillult-label" class="relative z-10 leading-tight text-center">ĐẠI CHIÊU</span>
              <span id="skillult-cd-text" class="relative z-10 text-[8px] font-mono opacity-95">4 / F</span>
            </button>
          </div>

          <button
            id="btn-blink"
            type="button"
            class="moba-btn relative overflow-hidden rounded-full px-4 py-2 sm:px-5 sm:py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-extrabold text-xs sm:text-sm border border-cyan-200/50 shadow-lg flex items-center gap-1.5 cursor-pointer"
          >
            <div id="blink-cooldown-fill" class="absolute inset-y-0 left-0 bg-slate-950/65 pointer-events-none" style="width: 0%;"></div>
            <span class="relative z-10">⚡</span>
            <span id="blink-label" class="relative z-10">TỐC BIẾN</span>
            <span class="relative z-10 text-[10px] opacity-80 hidden sm:inline">[Space]</span>
          </button>
        </div>

        <button
          id="btn-attack"
          type="button"
          class="moba-btn relative w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-amber-400 via-orange-500 to-rose-600 text-slate-950 font-black border-4 border-amber-200/80 shadow-2xl flex flex-col items-center justify-center cursor-pointer overflow-hidden"
        >
          <div id="attack-cd-fill" class="absolute inset-x-0 bottom-0 bg-slate-950/65 pointer-events-none" style="height: 0%;"></div>
          <span id="attack-icon" class="relative z-10 text-xl sm:text-2xl leading-none">🏹</span>
          <span id="attack-label" class="relative z-10 text-[9px] sm:text-[10px] tracking-wider mt-1 font-black">ĐÁNH THƯỜNG</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- Matchup Modal -->
  <div id="matchup-modal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm">
    <div class="glass-panel rounded-3xl max-w-lg w-full p-5 sm:p-6 shadow-2xl border border-slate-700/80 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-black text-white">Chọn Tướng &amp; Đấu Trường Sinh Tồn</h2>
          <p class="text-xs text-slate-300 mt-0.5">Sinh tồn 3 người (1 Cung, 1 Kiếm, 1 Pháp Sư), 3 mạng mỗi người — sống sót cuối cùng thắng!</p>
        </div>
        <button id="btn-close-matchup" type="button" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold cursor-pointer">✕</button>
      </div>

      <div class="space-y-4">
        <div>
          <div class="text-xs font-extrabold uppercase tracking-wider text-emerald-300 mb-2">1. Tướng Của Bạn</div>
          <div id="player-role-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2"></div>
        </div>

        <div>
          <div class="text-xs font-extrabold uppercase tracking-wider text-rose-300 mb-2">2. Tướng Đối Thủ Chính</div>
          <div id="enemy-role-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2"></div>
        </div>

        <div class="rounded-2xl bg-slate-900/75 border border-slate-700/70 p-3 text-[11px] sm:text-xs text-slate-300 space-y-1">
          <div>• <strong class="text-amber-300">Giữ chiêu để ngắm:</strong> Nhấn giữ nút chiêu và kéo để xem tầm &amp; hướng trước khi thả ra tung chiêu.</div>
          <div>• <strong class="text-emerald-300">Bụi Cỏ &amp; Hầm:</strong> Nấp bụi cỏ để tàng hình (nhận sát thương &amp; tung chiêu bình thường); thân cây chắn tầm nhìn AI.</div>
          <div>• <strong class="text-rose-300">Khống chế &amp; Đại chiêu (15s):</strong> Choáng/Chậm/Mù 1.5s, tụ đòn 0.5s, Tốc Biến 3x + 30% tốc chạy 3s.</div>
        </div>
      </div>

      <div class="mt-5 flex items-center justify-end gap-2.5">
        <button id="btn-start-matchup" type="button" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-sm shadow-lg hover:brightness-110 cursor-pointer">
          Vào Trận Sinh Tồn
        </button>
      </div>
    </div>
  </div>

  <!-- Game Over Modal -->
  <div id="gameover-modal" class="pointer-events-auto fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm" style="display: none;">
    <div class="pointer-events-auto glass-panel rounded-3xl max-w-md w-full p-6 text-center shadow-2xl border border-slate-700">
      <div id="gameover-icon" class="text-4xl mb-2">🏆</div>
      <h3 id="gameover-title" class="text-2xl font-black text-white">Chiến Thắng!</h3>
      <p id="gameover-desc" class="text-sm text-slate-300 mt-1.5">Bạn đã giành chiến thắng trong đấu trường sinh tồn 3 mạng.</p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <button id="btn-rematch" type="button" class="pointer-events-auto px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950 font-black text-sm shadow-lg cursor-pointer">
          Đấu Lại
        </button>
        <button id="btn-choose-new-target" type="button" class="pointer-events-auto px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-600 cursor-pointer">
          Đổi Mục Tiêu
        </button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      'use strict';

      const THREE_CDNS = [
        'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
        'https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js',
        'https://unpkg.com/three@0.128.0/build/three.min.js'
      ];

      function showErrorOverlay(message) {
        let box = document.getElementById('fatal-error-box');
        if (!box) {
          box = document.createElement('div');
          box.id = 'fatal-error-box';
          box.className = 'fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/90 text-white';
          box.innerHTML = `
            <div class="max-w-md w-full rounded-2xl border border-rose-500/40 bg-slate-900 p-5 text-center shadow-2xl">
              <div class="text-2xl mb-2">⚠️</div>
              <div class="font-black text-base text-rose-300 mb-1">Không thể khởi chạy khung cảnh 3D</div>
              <p id="fatal-error-msg" class="text-xs text-slate-300 mb-4 break-words"></p>
              <button type="button" onclick="location.reload()" class="px-4 py-2 rounded-xl bg-amber-400 text-slate-950 font-extrabold text-xs cursor-pointer">
                Tải lại trang
              </button>
            </div>
          `;
          document.body.appendChild(box);
        }
        const msgEl = document.getElementById('fatal-error-msg');
        if (msgEl) msgEl.textContent = message || 'Lỗi không xác định.';
      }

      function loadScriptTag(src) {
        return new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          s.onload = () => (window.THREE ? resolve(window.THREE) : reject(new Error('THREE chưa sẵn sàng từ ' + src)));
          s.onerror = () => reject(new Error('Lỗi tải ' + src));
          document.head.appendChild(s);
        });
      }

      function loadThreeWithFallback(urls) {
        if (window.THREE) return Promise.resolve(window.THREE);
        let chain = Promise.reject(new Error('Bắt đầu thử tải Three.js'));
        for (const url of urls) {
          chain = chain.catch(() => loadScriptTag(url));
        }
        return chain;
      }

      function startGame(THREE) {
        try {
          const canvas = document.getElementById('game-canvas');
          if (!canvas) {
            showErrorOverlay('Không tìm thấy thẻ canvas của trò chơi.');
            return;
          }
          const testCtx = canvas.getContext('webgl2') || canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
          if (!testCtx) {
            showErrorOverlay('Trình duyệt hoặc khung xem trước hiện tại không bật WebGL.');
            return;
          }

          const ARENA_RADIUS = 69;
        const MAX_LIVES = 3;
        const RESPAWN_INVULN = 1.6;
        const RESPAWN_DELAY = 2.0;
        const BASIC_ATTACK_COOLDOWN = 2.0;
        const AI_BASIC_ATTACK_COOLDOWN = 2.4;
        const WINDUP_DURATION = 0.5;
        const CC_DURATION = 1.5;
        const ULT_COOLDOWN = 15.0;
        const BLINK_COOLDOWN = 6.0;
        const BLINK_DISTANCE = 27.0;
        const BLINK_SPEED_BUFF_DURATION = 3.0;
        const BLINK_SPEED_MULT = 1.3;
        const BUSH_REVEAL_DURATION = 1.25;

        const ROLE_CONFIGS = {
          archer: {
            id: 'archer',
            name: 'Cung Thủ',
            icon: '🏹',
            maxHp: 120,
            moveSpeed: 8.2,
            basicDamage: 24,
            basicRange: 30,
            skill1Name: '10 Tiễn',
            skill1Range: 34,
            skill2Name: 'Tên Xuyên',
            skill2Range: 42,
            ccName: 'Tên Choáng',
            ccRange: 33,
            ccType: 'stun',
            ultName: 'Bão Tiễn 360°',
            ultRange: 69,
            attackLabel: 'ĐÁNH THƯỜNG'
          },
          swordsman: {
            id: 'swordsman',
            name: 'Kiếm Sĩ',
            icon: '⚔️',
            maxHp: 145,
            moveSpeed: 9.0,
            basicDamage: 28,
            basicRange: 4.8,
            skill1Name: 'Lướt Trảm',
            skill1Range: 10.5,
            skill2Name: 'Bão Kiếm',
            skill2Range: 5.5,
            ccName: 'Kiếm Choáng',
            ccRange: 10.0,
            ccType: 'stun',
            ultName: 'Trảm Địa Hỏa',
            ultRange: 69,
            attackLabel: 'ĐÁNH THƯỜNG'
          },
          mage: {
            id: 'mage',
            name: 'Pháp Sư',
            icon: '🔮',
            maxHp: 115,
            moveSpeed: 8.1,
            basicDamage: 25,
            basicRange: 28,
            skill1Name: 'Tia Tinh Thể',
            skill1Range: 34,
            skill2Name: 'Bất Tử 3s',
            skill2Range: 28,
            ccName: 'Vòng Băng',
            ccRange: 26,
            ccType: 'slow',
            ultName: 'Mưa Lửa 10s',
            ultRange: 69,
            attackLabel: 'ĐÁNH THƯỜNG'
          }
        };

        const TREE_OBSTACLES = [
          { x: -16, z: -12, r: 1.55, h: 7.2 },
          { x: 16, z: -12, r: 1.55, h: 7.5 },
          { x: -16, z: 12, r: 1.55, h: 7.0 },
          { x: 16, z: 12, r: 1.55, h: 7.4 },
          { x: 0, z: -24, r: 1.65, h: 8.0 },
          { x: 0, z: 24, r: 1.65, h: 7.8 },
          { x: -28, z: 0, r: 1.6, h: 7.6 },
          { x: 28, z: 0, r: 1.6, h: 7.6 },
          { x: -34, z: -26, r: 1.7, h: 8.2 },
          { x: 34, z: -26, r: 1.7, h: 8.0 },
          { x: -34, z: 26, r: 1.7, h: 7.9 },
          { x: 34, z: 26, r: 1.7, h: 8.3 },
          { x: -12, z: -40, r: 1.5, h: 7.2 },
          { x: 12, z: -40, r: 1.5, h: 7.4 },
          { x: -12, z: 40, r: 1.5, h: 7.3 },
          { x: 12, z: 40, r: 1.5, h: 7.1 },
          { x: -46, z: -12, r: 1.65, h: 8.1 },
          { x: 46, z: -12, r: 1.65, h: 7.8 },
          { x: -46, z: 12, r: 1.65, h: 7.7 },
          { x: 46, z: 12, r: 1.65, h: 8.0 }
        ];

        const SHELTER_TUNNELS = [
          { id: 'Hầm Tây-Bắc', p1: { x: -25, z: -20 }, p2: { x: -16, z: -26 }, radius: 3.3 },
