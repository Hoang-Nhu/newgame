        // Hệ thống chuyển đổi hướng màn hình & camera sang góc yaw thế giới thống nhất
        // Quy ước world forward: (sin(yaw), cos(yaw)) trên mặt phẳng XZ
        function screenDeltaToWorldYaw(dx, dy, fallbackYaw = 0) {
          if (Math.hypot(dx, dy) <= 10) return normalizeAngle(fallbackYaw);
          const camForwardX = state.cam.lookAt.x - state.cam.pos.x;
          const camForwardZ = state.cam.lookAt.z - state.cam.pos.z;
          const camYaw = Math.atan2(camForwardX, camForwardZ);
          const rightX = Math.cos(camYaw);
          const rightZ = -Math.sin(camYaw);
          const fwdX = Math.sin(camYaw);
          const fwdZ = Math.cos(camYaw);

          // dx > 0 kéo sang phải; dy > 0 kéo xuống dưới trên màn hình (tức là ngược trục tiến camera)
          const worldDirX = rightX * dx - fwdX * dy;
          const worldDirZ = rightZ * dx - fwdZ * dy;
          if (Math.hypot(worldDirX, worldDirZ) <= 0.0001) return normalizeAngle(fallbackYaw);
          return normalizeAngle(Math.atan2(worldDirX, worldDirZ));
        }

