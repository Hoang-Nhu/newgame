        function clamp(v, min, max) {
          return Math.max(min, Math.min(max, v));
        }

        function normalizeAngle(a) {
          while (a > Math.PI) a -= Math.PI * 2;
          while (a < -Math.PI) a += Math.PI * 2;
          return a;
        }

        function distToSegmentXZ(px, pz, ax, az, bx, bz) {
          const vx = bx - ax;
          const vz = bz - az;
          const wx = px - ax;
          const wz = pz - az;
          const lenSq = vx * vx + vz * vz;
          const t = lenSq > 0.00001 ? clamp((wx * vx + wz * vz) / lenSq, 0, 1) : 0;
          const projX = ax + vx * t;
          const projZ = az + vz * t;
          return Math.hypot(px - projX, pz - projZ);
        }

        function hasLineOfSightThroughTrees(a, b) {
          for (const t of TREE_OBSTACLES) {
            if (distToSegmentXZ(t.x, t.z, a.x, a.z, b.x, b.z) < t.r * 0.92) {
              return false;
            }
          }
          return true;
        }

        function getBushAt(pos) {
          for (const b of STEALTH_BUSHES) {
            if (Math.hypot(pos.x - b.x, pos.z - b.z) <= b.r) {
              return b;
            }
          }
          return null;
        }

        function isInsideShelter(pos) {
          for (const sh of SHELTER_TUNNELS) {
            if (distToSegmentXZ(pos.x, pos.z, sh.p1.x, sh.p1.z, sh.p2.x, sh.p2.z) <= sh.radius) {
              return true;
            }
          }
          return false;
        }

        function canObserverSeeTarget(observer, target) {
          if (!observer || !target || target.isDead || target.lives <= 0) return false;
          if (!hasLineOfSightThroughTrees(observer.pos, target.pos)) return false;
          if (target.isStealthed) {
            const sameBush = observer.inBush && target.inBush && observer.inBush.id === target.inBush.id;
            const closeProximity = Math.hypot(observer.pos.x - target.pos.x, observer.pos.z - target.pos.z) <= 2.4;
            return Boolean(sameBush || closeProximity);
