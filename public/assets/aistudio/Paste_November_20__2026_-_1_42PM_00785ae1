          joystickKnob: document.getElementById('joystick-knob'),
          btnAttack: document.getElementById('btn-attack'),
          attackIcon: document.getElementById('attack-icon'),
          attackLabel: document.getElementById('attack-label'),
          attackCdFill: document.getElementById('attack-cd-fill'),
          btnSkill1: document.getElementById('btn-skill-1'),
          skill1Label: document.getElementById('skill1-label'),
          skill1CdText: document.getElementById('skill1-cd-text'),
          skill1CdFill: document.getElementById('skill1-cd-fill'),
          btnSkill2: document.getElementById('btn-skill-2'),
          skill2Label: document.getElementById('skill2-label'),
          skill2CdText: document.getElementById('skill2-cd-text'),
          skill2CdFill: document.getElementById('skill2-cd-fill'),
          btnSkillCc: document.getElementById('btn-skill-cc'),
          skillccLabel: document.getElementById('skillcc-label'),
          skillccCdText: document.getElementById('skillcc-cd-text'),
          skillccCdFill: document.getElementById('skillcc-cd-fill'),
          btnSkillUlt: document.getElementById('btn-skill-ult'),
          skillultLabel: document.getElementById('skillult-label'),
          skillultCdText: document.getElementById('skillult-cd-text'),
          skillultCdFill: document.getElementById('skillult-cd-fill'),
          btnBlink: document.getElementById('btn-blink'),
          blinkLabel: document.getElementById('blink-label'),
          blinkCooldownFill: document.getElementById('blink-cooldown-fill'),
          calloutLayer: document.getElementById('callout-layer')
        };

        // Hold-to-Preview 3D Skill Range & Direction Indicator
        const telegraph = {
          active: false,
          kind: null,
          pointerId: null,
          startX: 0,
          startY: 0,
          yaw: 0,
          aoeDist: 12,
          group: new THREE.Group(),
          rangeRing: null,
          arrowGroup: null,
          coneMesh: null,
          aoeMarker: null
        };

        function buildTelegraphMeshes() {
          telegraph.group.visible = false;
          scene.add(telegraph.group);

          telegraph.rangeRing = new THREE.Mesh(
            new THREE.RingGeometry(0.96, 1.0, 48),
            new THREE.MeshBasicMaterial({
              color: 0x38bdf8,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.45
            })
          );
          telegraph.rangeRing.rotation.x = -Math.PI / 2;
          telegraph.rangeRing.position.y = 0.08;
          telegraph.group.add(telegraph.rangeRing);

          telegraph.arrowGroup = new THREE.Group();
          const shaft = new THREE.Mesh(
            new THREE.PlaneGeometry(1.1, 1.0),
            new THREE.MeshBasicMaterial({
              color: 0xfbbf24,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.36
            })
          );
          shaft.rotation.x = -Math.PI / 2;
          shaft.position.set(0, 0.09, 0.5);
          telegraph.arrowGroup.add(shaft);

          const head = new THREE.Mesh(
            new THREE.ConeGeometry(1.05, 1.8, 3),
            new THREE.MeshBasicMaterial({
              color: 0xfef08a,
              transparent: true,
              opacity: 0.65
            })
          );
          head.rotation.x = Math.PI / 2;
          head.position.set(0, 0.12, 1.35);
          telegraph.arrowGroup.add(head);
          telegraph.group.add(telegraph.arrowGroup);

          telegraph.coneMesh = new THREE.Mesh(
            new THREE.CircleGeometry(1, 28, -0.55, 1.1),
            new THREE.MeshBasicMaterial({
              color: 0xf59e0b,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.3
            })
          );
          telegraph.coneMesh.rotation.x = -Math.PI / 2;
          telegraph.coneMesh.position.y = 0.09;
          telegraph.group.add(telegraph.coneMesh);

          telegraph.aoeMarker = new THREE.Mesh(
            new THREE.RingGeometry(0.15, 1.0, 32),
            new THREE.MeshBasicMaterial({
              color: 0x38bdf8,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.55
            })
          );
          telegraph.aoeMarker.rotation.x = -Math.PI / 2;
          telegraph.aoeMarker.position.y = 0.1;
          telegraph.group.add(telegraph.aoeMarker);
        }
        buildTelegraphMeshes();

        function getSkillTelegraphSpec(fighter, kind) {
          const cfg = fighter.cfg;
          if (kind === 'blink') {
            return { type: 'line', range: BLINK_DISTANCE, width: 1.5, color: 0x38bdf8 };
          }
          if (kind === 'ult') {
            return { type: 'circle', range: cfg.ultRange, color: 0xfbbf24 };
          }
          if (kind === 'basic') {
            const isMelee = fighter.role === 'swordsman' || fighter.role === 'tiger';
            return isMelee
              ? { type: 'cone', range: cfg.basicRange, color: 0xfbbf24 }
              : { type: 'line', range: cfg.basicRange, width: 1.2, color: 0xfbbf24 };
          }
          if (kind === 'skill1') {
            if (fighter.role === 'archer' || fighter.role === 'mage') {
              return { type: 'cone', range: cfg.skill1Range, color: 0xf59e0b };
            }
            return { type: 'line', range: cfg.skill1Range, width: 2.2, color: 0x22d3ee };
          }
          if (kind === 'skill2') {
            if (fighter.role === 'mage') {
              return { type: 'circle', range: 6.5, color: 0x67e8f9 };
            }
            if (fighter.role === 'swordsman') {
              return { type: 'circle', range: cfg.skill2Range, color: 0x818cf8 };
            }
            return { type: 'line', range: cfg.skill2Range, width: 1.6, color: 0xfef08a };
          }
          if (kind === 'cc') {
            if (fighter.role === 'mage') {
              return { type: 'aoe', range: cfg.ccRange, aoeRadius: 4.8, color: 0x38bdf8 };
            }
            if (fighter.role === 'swordsman') {
              return { type: 'cone', range: cfg.ccRange, color: 0xf43f5e };
            }
            return { type: 'line', range: cfg.ccRange, width: 1.4, color: 0xf43f5e };
          }
          return { type: 'line', range: 12, width: 1.2, color: 0xfbbf24 };
        }

        function updateTelegraphVisual() {
          const p = state.player;
          if (!telegraph.active || !p || p.isDead || state.matchOver) {
            telegraph.group.visible = false;
            return;
          }
          const spec = getSkillTelegraphSpec(p, telegraph.kind);
          telegraph.group.visible = true;
          telegraph.group.position.set(p.pos.x, 0, p.pos.z);

          telegraph.rangeRing.scale.setScalar(spec.range);
          telegraph.rangeRing.material.color.setHex(spec.color);

          telegraph.arrowGroup.visible = spec.type === 'line' || spec.type === 'aoe';
          telegraph.coneMesh.visible = spec.type === 'cone';
          telegraph.aoeMarker.visible = spec.type === 'aoe';

          const dir = yawToDirXZ(telegraph.yaw);

          if (spec.type === 'line') {
            telegraph.arrowGroup.rotation.y = telegraph.yaw;
            const shaft = telegraph.arrowGroup.children[0];
            const head = telegraph.arrowGroup.children[1];
            const len = Math.max(2, spec.range - 1.4);
            shaft.scale.set(spec.width || 1.2, len, 1);
            shaft.position.set(0, 0.09, len * 0.5);
            shaft.material.color.setHex(spec.color);
            head.position.set(0, 0.12, len + 0.45);
            head.material.color.setHex(spec.color);
          } else if (spec.type === 'cone') {
            telegraph.coneMesh.rotation.z = -telegraph.yaw + Math.PI * 0.5;
            telegraph.coneMesh.scale.setScalar(spec.range);
            telegraph.coneMesh.material.color.setHex(spec.color);
          } else if (spec.type === 'aoe') {
            telegraph.arrowGroup.rotation.y = telegraph.yaw;
            const dist = clamp(telegraph.aoeDist, 3, spec.range);
            const shaft = telegraph.arrowGroup.children[0];
            const head = telegraph.arrowGroup.children[1];
            shaft.scale.set(0.8, Math.max(1, dist - 1.0), 1);
            shaft.position.set(0, 0.09, Math.max(0.5, (dist - 1.0) * 0.5));
            shaft.material.color.setHex(spec.color);
            head.position.set(0, 0.12, dist);
            head.material.color.setHex(spec.color);

            const r = spec.aoeRadius || 4.8;
            telegraph.aoeMarker.position.set(dir.x * dist, 0.1, dir.z * dist);
            telegraph.aoeMarker.scale.setScalar(r);
            telegraph.aoeMarker.material.color.setHex(spec.color);
          }
        }

        function startHoldPreview(kind, clientX, clientY) {
          const p = state.player;
          if (!p || p.isDead || state.matchOver) return;
          telegraph.active = true;
          telegraph.kind = kind;
          telegraph.pointerId = 'hold';
          telegraph.startX = clientX;
          telegraph.startY = clientY;
          telegraph.yaw = normalizeAngle(p.yaw);
          const spec = getSkillTelegraphSpec(p, kind);
          telegraph.aoeDist = Math.min(14, spec.range * 0.65);
          if (kind === 'basic') state.attackHeld = true;
          updateTelegraphVisual();
        }

        function moveHoldPreview(clientX, clientY) {
          if (!telegraph.active) return;
          const dx = clientX - telegraph.startX;
          const dy = clientY - telegraph.startY;
          if (Math.hypot(dx, dy) > 10) {
            telegraph.yaw = screenDeltaToWorldYaw(dx, dy, telegraph.yaw);
            const p = state.player;
            const spec = getSkillTelegraphSpec(p, telegraph.kind);
            if (spec.type === 'aoe') {
              telegraph.aoeDist = clamp(Math.hypot(dx, dy) * 0.22, 3, spec.range);
            }
          }
          updateTelegraphVisual();
        }

        function releaseHoldPreview() {
          if (!telegraph.active) return;
          const kind = telegraph.kind;
          // Khóa chặt hướng ngắm tại đúng thời điểm thả tay xác nhận
          const lockedYaw = normalizeAngle(telegraph.yaw);
          const dir = yawToDirXZ(lockedYaw);
          const spec = getSkillTelegraphSpec(state.player, kind);
          const customPos =
            spec.type === 'aoe' && state.player
              ? new THREE.Vector3(
                  state.player.pos.x + dir.x * telegraph.aoeDist,
                  0,
                  state.player.pos.z + dir.z * telegraph.aoeDist
                )
              : null;

          telegraph.active = false;
          telegraph.pointerId = null;
          telegraph.group.visible = false;
          if (kind === 'basic') state.attackHeld = false;

          if (!state.player || state.player.isDead || state.matchOver) return;
          if (kind === 'blink') {
            state.player.yaw = lockedYaw;
            state.player.rig.root.rotation.y = lockedYaw;
            triggerBlink(state.player, lockedYaw);
          } else {
            beginCastWindup(state.player, kind, lockedYaw, customPos);
          }
        }

        // Fighter Creation, Respawn & Match Reset
        function createFighter(role, isPlayer, labelSuffix = '') {
          const cfg = ROLE_CONFIGS[role] || ROLE_CONFIGS.archer;
          const rig = buildFighterRig(role, isPlayer);
          scene.add(rig.root);

          return {
            role,
            isPlayer,
            displayName: labelSuffix ? `${cfg.name} ${labelSuffix}` : isPlayer ? cfg.name : `${cfg.name} AI`,
            cfg,
            rig,
            parts: rig.parts || {},
            pos: new THREE.Vector3(0, 0, 0),
            yaw: 0,
            hp: cfg.maxHp,
            maxHp: cfg.maxHp,
            lives: MAX_LIVES,
            isDead: false,
            respawnTimer: 0,
            invulnTimer: 0,
            immortalTimer: 0,
            hidingInShelter: false,
            inBush: null,
            bushRevealTimer: 0,
            isStealthed: false,
            attackCooldown: 0,
            skill1Cd: 0,
            skill2Cd: 0,
            skillCcCd: 0,
            skillUltCd: 0,
            blinkCd: 0,
            speedBuffTimer: 0,
            stunTimer: 0,
            slowTimer: 0,
            blindTimer: 0,
            fireTickTimer: 0,
            windup: { active: false, kind: null, timer: 0, maxTimer: WINDUP_DURATION, target: null, customPos: null },
            animTime: Math.random() * 10,
            aiThinkTimer: 1.15,
            aiSkillGlobalLock: 0.8,
            aiLastKnownPos: null,
            aiMoveDir: { x: 0, z: 0 }
          };
        }

        function getAllEnemiesOf(fighter) {
          return state.allFighters.filter((f) => f && f !== fighter && !f.isDead && f.lives > 0);
        }

        function findNearestEnemyOf(fighter) {
          let best = null;
          let bestDist = Infinity;
          for (const other of state.allFighters) {
            if (!other || other === fighter || other.isDead || other.lives <= 0) continue;
            const d = Math.hypot(other.pos.x - fighter.pos.x, other.pos.z - fighter.pos.z);
            if (d < bestDist) {
              bestDist = d;
              best = other;
            }
          }
          return best;
        }

        function spawnFighterAtAngle(fighter, angleRad, radiusDist = 42) {
          fighter.pos.set(Math.cos(angleRad) * radiusDist, 0, Math.sin(angleRad) * radiusDist);
          resolveArenaAndObstacles(fighter.pos, 0.8);
          fighter.yaw = Math.atan2(-fighter.pos.x, -fighter.pos.z);
          fighter.rig.root.position.copy(fighter.pos);
          fighter.rig.root.position.y = 0;
          fighter.rig.root.rotation.y = fighter.yaw;
        }

        function respawnFighterOnSpot(fighter) {
          fighter.hp = fighter.maxHp;
          fighter.isDead = false;
          fighter.respawnTimer = 0;
          fighter.invulnTimer = RESPAWN_INVULN;
          fighter.immortalTimer = 0;
          fighter.bushRevealTimer = 0;
          fighter.stunTimer = 0;
          fighter.slowTimer = 0;
          fighter.blindTimer = 0;
          fighter.windup = { active: false, kind: null, timer: 0, maxTimer: WINDUP_DURATION, target: null, customPos: null };
          fighter.pos.y = 0;
          resolveArenaAndObstacles(fighter.pos, 0.8);
          fighter.rig.bodyGroup.rotation.set(0, 0, 0);
          fighter.rig.bodyGroup.position.set(0, 0, 0);
          fighter.rig.root.position.copy(fighter.pos);
          fighter.rig.root.position.y = 0;
        }

        function clearAllCombatObjects() {
          for (const p of state.projectiles) disposeObject3D(p.mesh);
          state.projectiles.length = 0;

          for (const s of state.slashArcs) {
            disposeObject3D(s.mesh);
            if (s.trailMesh) disposeObject3D(s.trailMesh);
          }
          state.slashArcs.length = 0;

          for (const z of state.aoeZones) {
            disposeObject3D(z.outerRing);
            disposeObject3D(z.innerDisc);
          }
          state.aoeZones.length = 0;

          for (const ft of state.fireTrails) disposeObject3D(ft.mesh);
          state.fireTrails.length = 0;

          for (const mz of state.meteorZones) {
            disposeObject3D(mz.mesh);
            disposeObject3D(mz.warnRing);
          }
          state.meteorZones.length = 0;

          state.meteorRainTimer = 0;
          state.meteorRainOwner = null;

          for (const fx of state.specialFx) disposeObject3D(fx.mesh);
          state.specialFx.length = 0;

          for (const pt of state.particles) disposeObject3D(pt.mesh);
          state.particles.length = 0;

          for (const c of state.callouts) {
            if (c.el && c.el.parentNode) c.el.parentNode.removeChild(c.el);
          }
          state.callouts.length = 0;
        }

        function syncHudLabels() {
          const pCfg = state.player.cfg;
          const eCfg = state.enemy.cfg;
          const aliveCount = state.allFighters.filter((f) => f.lives > 0).length;

          ui.playerRoleBadge.textContent = `${pCfg.icon} ${pCfg.name}`;
          ui.enemyRoleBadge.textContent = `${eCfg.icon} ${eCfg.name} AI`;
          ui.matchupSummary.textContent = `Sinh Tồn (${aliveCount}/${state.allFighters.length} sống)`;

          ui.attackIcon.textContent = pCfg.icon;
          ui.attackLabel.textContent = pCfg.attackLabel;
          ui.skill1Label.textContent = pCfg.skill1Name;
          ui.skill2Label.textContent = pCfg.skill2Name;
          ui.skillccLabel.textContent = pCfg.ccName;
          ui.skillultLabel.textContent = pCfg.ultName;
        }

        function startMatch(playerRole, enemyRole) {
          try {
            state.playerRole = ROLE_CONFIGS[playerRole] ? playerRole : 'archer';
            state.enemyRole = ROLE_CONFIGS[enemyRole] ? enemyRole : 'swordsman';
            state.matchOver = false;

            for (const f of state.allFighters) {
              if (f && f.rig && f.rig.root) disposeObject3D(f.rig.root);
            }
            state.allFighters.length = 0;
            clearAllCombatObjects();

            state.player = null;
            state.enemy = null;

            // Chỉ giữ đúng 3 lớp nhân vật: Cung Thủ, Kiếm Sĩ, Pháp Sư
            const baseRoles = ['archer', 'swordsman', 'mage'];
            const finalSpecs = [];
            let assignedPlayer = false;

            for (let i = 0; i < baseRoles.length; i++) {
              const role = baseRoles[i];
              if (!assignedPlayer && role === state.playerRole) {
                assignedPlayer = true;
                finalSpecs.push({ role, isPlayer: true, suffix: '' });
              } else {
                finalSpecs.push({
                  role,
                  isPlayer: false,
                  suffix: 'AI'
                });
              }
            }

            if (!assignedPlayer) {
              finalSpecs[0] = { role: state.playerRole, isPlayer: true, suffix: '' };
            }

            finalSpecs.forEach((spec, idx) => {
              const fighter = createFighter(spec.role, spec.isPlayer, spec.suffix);
              const ang = (idx / finalSpecs.length) * Math.PI * 2 + 0.35;
              spawnFighterAtAngle(fighter, ang, 42);
              state.allFighters.push(fighter);
              if (!state.player && spec.isPlayer) state.player = fighter;
              if (!state.enemy && !spec.isPlayer && spec.role === state.enemyRole) state.enemy = fighter;
            });

            if (!state.player && state.allFighters.length > 0) state.player = state.allFighters[0];
            if (!state.enemy && state.allFighters.length > 0) {
              state.enemy = state.allFighters.find((f) => f && !f.isPlayer) || state.allFighters[0];
            }

            syncHudLabels();
            updateHud(true);
          } catch (err) {
            console.error('Lỗi khởi tạo trận đấu:', err);
          }
        }

        function spawnCallout(worldPos, text, color = '#fde047') {
          if (!ui.calloutLayer) return;
          const el = document.createElement('div');
          el.className = 'callout-item text-xs sm:text-sm';
          el.style.color = color;
          el.textContent = text;
          ui.calloutLayer.appendChild(el);
          state.callouts.push({
            el,
            pos: worldPos.clone().add(new THREE.Vector3(0, 2.5, 0)),
            life: 0.85,
            maxLife: 0.85
          });
        }

        function spawnBurst(origin, count = 8, colorHex = 0xfbbf24, speed = 5.5) {
          if (state.particles.length > 72) return;
          const safeCount = Math.min(count, 8, 72 - state.particles.length);
          const geo = new THREE.SphereGeometry(0.16, 6, 6);
          const mat = new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.95 });
          for (let i = 0; i < safeCount; i++) {
            const m = new THREE.Mesh(geo, mat);
            m.position.copy(origin);
            scene.add(m);
            const ang = Math.random() * Math.PI * 2;
            const spd = speed * (0.45 + Math.random() * 0.75);
            state.particles.push({
              mesh: m,
              vel: new THREE.Vector3(Math.cos(ang) * spd, 2.2 + Math.random() * 3.8, Math.sin(ang) * spd),
              life: 0.45 + Math.random() * 0.25,
              maxLife: 0.7
            });
          }
        }

        function spawnMageSparkles(origin, count = 6, colorHex = 0xe879f9) {
          if (state.particles.length > 72) return;
          const cappedCount = Math.min(count, 6, 72 - state.particles.length);
          const geo = new THREE.OctahedronGeometry(0.2, 0);
          const mat = new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.95 });
          for (let i = 0; i < cappedCount; i++) {
            const m = new THREE.Mesh(geo, mat);
            m.position.copy(origin);
            scene.add(m);
            const ang = Math.random() * Math.PI * 2;
            const spd = 2.2 + Math.random() * 5.2;
            state.particles.push({
              mesh: m,
              vel: new THREE.Vector3(Math.cos(ang) * spd, 2.0 + Math.random() * 4.2, Math.sin(ang) * spd),
              life: 0.55 + Math.random() * 0.35,
              maxLife: 0.9
            });
          }
        }

        function applyDamage(attacker, target, rawAmount, options = {}) {
          if (!target || target.isDead || target.lives <= 0 || state.matchOver) return false;
          if (target.invulnTimer > 0 || target.immortalTimer > 0) {
            if (options.showImmune !== false) {
              spawnCallout(target.pos, 'BẤT TỬ', '#67e8f9');
            }
            return false;
          }

          let dmg = Math.max(1, rawAmount);
          if (options.reduceInBushOrShelter && (target.inBush || isInsideShelter(target.pos))) {
            dmg *= 0.5;
          }

          target.hp -= dmg;
          target.bushRevealTimer = BUSH_REVEAL_DURATION;
          spawnBurst(target.pos.clone().add(new THREE.Vector3(0, 1.1, 0)), 6, options.color || 0xfb7185, 4.8);
          spawnCallout(target.pos, `-${Math.round(dmg)}`, options.textColor || '#fda4af');

          if (target.hp <= 0) {
            target.hp = 0;
            target.lives = Math.max(0, target.lives - 1);
            if (target.lives > 0) {
              target.isDead = true;
              target.respawnTimer = RESPAWN_DELAY;
              target.rig.bodyGroup.rotation.x = Math.PI * 0.45;
              target.rig.bodyGroup.position.y = -0.35;
              spawnCallout(target.pos, `MẤT 1 MẠNG (${target.lives})`, '#facc15');
            } else {
              target.isDead = true;
              target.rig.bodyGroup.rotation.x = Math.PI * 0.5;
              target.rig.bodyGroup.position.y = -0.5;
              spawnCallout(target.pos, 'BỊ LOẠI!', '#ef4444');
              checkSurvivalWinner();
            }
          }
          return true;
        }

        function applyCrowdControl(attacker, target, ccType, duration = CC_DURATION) {
          if (!target || target.isDead || target.lives <= 0) return;
          if (target.invulnTimer > 0 || target.immortalTimer > 0) return;
          if (ccType === 'stun') {
            target.stunTimer = Math.max(target.stunTimer, duration);
            target.windup.active = false;
            spawnCallout(target.pos, 'CHOÁNG 1.5s', '#facc15');
          } else if (ccType === 'slow') {
            target.slowTimer = Math.max(target.slowTimer, duration);
            spawnCallout(target.pos, 'CHẬM 1.5s', '#38bdf8');
          } else if (ccType === 'blind') {
            target.blindTimer = Math.max(target.blindTimer, duration);
            spawnCallout(target.pos, 'MÙ 1.5s', '#fb7185');
          }
        }

        function spawnProjectile(opts) {
          if (state.projectiles.length > 120) return;
          const yaw = normalizeAngle(opts.yaw !== undefined ? opts.yaw : Math.atan2(opts.dirX, opts.dirZ));
          const dir = yawToDirXZ(yaw);
          opts.mesh.rotation.set(0, yaw, 0);
          state.projectiles.push({
            owner: opts.owner,
            mesh: opts.mesh,
            pos: opts.pos.clone(),
            yaw,
            dirX: dir.x,
            dirZ: dir.z,
            speed: opts.speed,
            damage: opts.damage,
            maxDist: opts.maxDist,
            traveled: 0,
            radius: opts.radius || 0.75,
            pierceObstacles: Boolean(opts.pierceObstacles),
            pierceEnemies: Boolean(opts.pierceEnemies),
            damageScaleOnHit: opts.damageScaleOnHit || 1.0,
            stopOnFirstEnemy: Boolean(opts.stopOnFirstEnemy),
            ccType: opts.ccType || null,
            ccDuration: opts.ccDuration || CC_DURATION,
            isMage: Boolean(opts.isMage),
            hitSet: new Set()
          });
          scene.add(opts.mesh);
        }

        function spawnSlashArc(owner, radius, yaw, colorHex = 0x38bdf8, damage = 25, ccType = null) {
          const lockedYaw = normalizeAngle(yaw);
          const dir = yawToDirXZ(lockedYaw);
          const arcGeo = new THREE.RingGeometry(radius * 0.45, radius, 24, 1, -0.75, 1.5);
          const arcMat = new THREE.MeshBasicMaterial({
            color: colorHex,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.75
          });
          const mesh = new THREE.Mesh(arcGeo, arcMat);
          mesh.rotation.set(-Math.PI / 2, 0, -lockedYaw + Math.PI * 0.5);
          mesh.position.set(owner.pos.x, 0.25, owner.pos.z);
          scene.add(mesh);

          state.slashArcs.push({
            owner,
            mesh,
            trailMesh: null,
            life: 0.28,
            maxLife: 0.28,
            maxScale: 1.15
          });

          for (const enemy of getAllEnemiesOf(owner)) {
            const dx = enemy.pos.x - owner.pos.x;
            const dz = enemy.pos.z - owner.pos.z;
            const dist = Math.hypot(dx, dz);
            if (dist <= radius + 0.9) {
              const angToEnemy = Math.atan2(dx, dz);
              const diff = Math.abs(normalizeAngle(angToEnemy - lockedYaw));
              if (diff <= 0.95 || dist <= 2.0) {
                applyDamage(owner, enemy, damage, { color: colorHex });
                if (ccType) applyCrowdControl(owner, enemy, ccType, CC_DURATION);
              }
            }
          }
        }

        function spawnFireTrailAlongLine(owner, startPos, yaw, length, width, duration = 10.0, tickDmg = 8) {
          const lockedYaw = normalizeAngle(yaw);
          const dir = yawToDirXZ(lockedYaw);
          const geo = new THREE.PlaneGeometry(width, length);
          const mat = new THREE.MeshBasicMaterial({
            color: 0xf97316,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.34
          });
          const mesh = new THREE.Mesh(geo, mat);
          mesh.rotation.set(-Math.PI / 2, 0, -lockedYaw);
          const midX = startPos.x + dir.x * (length * 0.5);
          const midZ = startPos.z + dir.z * (length * 0.5);
          mesh.position.set(midX, 0.06, midZ);
          scene.add(mesh);

          state.fireTrails.push({
            owner,
            mesh,
            ax: startPos.x,
            az: startPos.z,
            bx: startPos.x + dir.x * length,
            bz: startPos.z + dir.z * length,
            halfWidth: width * 0.5,
            life: duration,
            maxLife: duration,
            tickTimer: 0.25,
            tickDmg
          });
        }

        function spawnMeteorRainStrike(owner) {
          const ang = Math.random() * Math.PI * 2;
          const rad = Math.sqrt(Math.random()) * (ARENA_RADIUS - 3);
          const mx = Math.cos(ang) * rad;
          const mz = Math.sin(ang) * rad;
          const radius = 2.4;

          const meteorMesh = new THREE.Mesh(
            new THREE.SphereGeometry(0.95, 12, 12),
            new THREE.MeshStandardMaterial({
              color: 0xfef08a,
              emissive: 0xf97316,
              emissiveIntensity: 1.9
            })
          );
          meteorMesh.position.set(mx, 18, mz);
          scene.add(meteorMesh);

          const warnRing = new THREE.Mesh(
            new THREE.RingGeometry(0.25, radius, 24),
            new THREE.MeshBasicMaterial({
              color: 0xfb923c,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.55
            })
          );
          warnRing.rotation.x = -Math.PI / 2;
          warnRing.position.set(mx, 0.05, mz);
          scene.add(warnRing);

          state.meteorZones.push({
            owner,
            mesh: meteorMesh,
            warnRing,
            x: mx,
            z: mz,
            radius,
            fallTime: 0.45,
            exploded: false,
            puddleLife: 3.0,
            tickTimer: 0.4
          });
        }

        function triggerBlink(fighter) {
          if (!fighter || fighter.isDead || fighter.stunTimer > 0 || fighter.blinkCd > 0 || state.matchOver) return;
          fighter.blinkCd = BLINK_COOLDOWN;
          fighter.speedBuffTimer = BLINK_SPEED_BUFF_DURATION;
        function triggerBlink(fighter, explicitYaw = null) {
          if (!fighter || fighter.isDead || fighter.stunTimer > 0 || fighter.blinkCd > 0 || state.matchOver) return;
          const lockedYaw = normalizeAngle(explicitYaw !== null ? explicitYaw : fighter.yaw);
          const dir = yawToDirXZ(lockedYaw);
          fighter.yaw = lockedYaw;
          fighter.rig.root.rotation.y = lockedYaw;
          fighter.blinkCd = BLINK_COOLDOWN;
          fighter.speedBuffTimer = BLINK_SPEED_BUFF_DURATION;
          spawnBurst(fighter.pos.clone().add(new THREE.Vector3(0, 1, 0)), 7, 0x38bdf8, 6.0);
          fighter.pos.x += dir.x * BLINK_DISTANCE;
          fighter.pos.z += dir.z * BLINK_DISTANCE;
          resolveArenaAndObstacles(fighter.pos, 0.8);
          fighter.rig.root.position.copy(fighter.pos);
          fighter.rig.root.position.y = 0;
          spawnBurst(fighter.pos.clone().add(new THREE.Vector3(0, 1, 0)), 7, 0x67e8f9, 6.0);
          spawnCallout(fighter.pos, 'TỐC BIẾN +30% TỐC', '#38bdf8');
        }

        function executeCast(fighter, kind, aimYaw, customPos = null) {
          if (!fighter || fighter.isDead || state.matchOver) return;
          // Hướng đã khóa khi bắt đầu tụ chiêu được dùng tuyệt đối, không bị đổi theo camera hay nhân vật sau đó
          const lockedYaw = normalizeAngle(aimYaw);
          const dir = yawToDirXZ(lockedYaw);
          const dirX = dir.x;
          const dirZ = dir.z;
          const cfg = fighter.cfg;
          const origin = fighter.pos.clone().add(new THREE.Vector3(0, 1.25, 0));

          if (kind === 'basic') {
            fighter.attackCooldown = fighter.isPlayer ? BASIC_ATTACK_COOLDOWN : AI_BASIC_ATTACK_COOLDOWN;
            if (fighter.role === 'archer') {
              spawnProjectile({
                owner: fighter,
                mesh: createArrowMesh(0xfbbf24, 1.0),
                pos: origin.clone().add(new THREE.Vector3(dirX * 0.9, 0, dirZ * 0.9)),
                yaw: lockedYaw,
                dirX,
                dirZ,
                speed: 28,
                damage: cfg.basicDamage,
                maxDist: cfg.basicRange,
                radius: 0.72
              });
            } else if (fighter.role === 'mage') {
              spawnProjectile({
                owner: fighter,
                mesh: createMageOrbMesh(0xe879f9, 0.34),
                pos: origin.clone().add(new THREE.Vector3(dirX * 0.9, 0, dirZ * 0.9)),
                yaw: lockedYaw,
                dirX,
                dirZ,
                speed: 25,
                damage: cfg.basicDamage,
                maxDist: cfg.basicRange,
                radius: 0.8,
                isMage: true
              });
              spawnMageSparkles(origin, 6, 0xf0abfc);
            } else {
              spawnSlashArc(fighter, cfg.basicRange, lockedYaw, 0x38bdf8, cfg.basicDamage, null);
            }
            return;
          }

          if (kind === 'skill1') {
            fighter.skill1Cd = 5.0;
            if (fighter.role === 'archer') {
              // 10 mũi tên thẳng hàng theo đúng hướng đã khóa
              for (let i = 0; i < 10; i++) {
                const lag = i * 1.35;
                const spread = (i - 4.5) * 0.025;
                const a = normalizeAngle(lockedYaw + spread);
                const dVec = yawToDirXZ(a);
                const px = origin.x + dVec.x * (1.2 + lag * 0.45);
                const pz = origin.z + dVec.z * (1.2 + lag * 0.45);
                spawnProjectile({
                  owner: fighter,
                  mesh: createArrowMesh(0xfacc15, 1.0),
                  pos: new THREE.Vector3(px, origin.y, pz),
                  yaw: a,
                  dirX: dVec.x,
                  dirZ: dVec.z,
                  speed: 27 + i * 0.4,
                  damage: 11,
                  maxDist: cfg.skill1Range,
                  radius: 0.72
                });
              }
            } else if (fighter.role === 'swordsman') {
              fighter.pos.x += dirX * cfg.skill1Range;
              fighter.pos.z += dirZ * cfg.skill1Range;
              resolveArenaAndObstacles(fighter.pos, 0.8);
              fighter.rig.root.position.copy(fighter.pos);
              spawnSlashArc(fighter, 5.6, lockedYaw, 0x22d3ee, 34, null);
            } else if (fighter.role === 'mage') {
              for (const offset of [-0.22, 0, 0.22]) {
                const a = normalizeAngle(lockedYaw + offset);
                const dVec = yawToDirXZ(a);
                spawnProjectile({
                  owner: fighter,
                  mesh: createMageOrbMesh(0x38bdf8, 0.36),
                  pos: origin.clone().add(new THREE.Vector3(dVec.x * 0.9, 0, dVec.z * 0.9)),
                  yaw: a,
                  dirX: dVec.x,
                  dirZ: dVec.z,
                  speed: 26,
                  damage: 18,
                  maxDist: cfg.skill1Range,
                  radius: 0.85,
                  isMage: true
                });
              }
              spawnMageSparkles(origin, 8, 0x67e8f9);
            }
            return;
          }

          if (kind === 'skill2') {
            fighter.skill2Cd = 6.5;
            if (fighter.role === 'archer') {
              // Bắn xuyên vật cản, giảm 50% sát thương khi trúng đòn
              spawnProjectile({
                owner: fighter,
                mesh: createArrowMesh(0xe879f9, 1.35),
                pos: origin.clone().add(new THREE.Vector3(dirX * 1.0, 0, dirZ * 1.0)),
                yaw: lockedYaw,
                dirX,
                dirZ,
                speed: 30,
                damage: 36,
                maxDist: cfg.skill2Range,
                radius: 0.95,
                pierceObstacles: true,
                pierceEnemies: true,
                damageScaleOnHit: 0.5
              });
            } else if (fighter.role === 'mage') {
              fighter.immortalTimer = Math.max(fighter.immortalTimer, 3.0);
              spawnCallout(fighter.pos, 'BẤT TỬ 3s', '#67e8f9');
              spawnMageSparkles(origin, 8, 0x67e8f9);

              let bestTarget = null;
              let bestScore = Infinity;
              for (const other of getAllEnemiesOf(fighter)) {
                const dx = other.pos.x - fighter.pos.x;
                const dz = other.pos.z - fighter.pos.z;
                const d = Math.hypot(dx, dz);
                if (d <= cfg.skill2Range) {
                  const angDiff = Math.abs(normalizeAngle(Math.atan2(dx, dz) - lockedYaw));
                  const score = d + angDiff * 12;
                  if (score < bestScore) {
                    bestScore = score;
                    bestTarget = other;
                  }
                }
              }
              if (bestTarget) {
                bestTarget.immortalTimer = Math.max(bestTarget.immortalTimer, 3.0);
                spawnCallout(bestTarget.pos, 'BẤT TỬ 3s', '#67e8f9');
                spawnMageSparkles(bestTarget.pos.clone().add(new THREE.Vector3(0, 1.2, 0)), 8, 0xf0abfc);
              }
            } else if (fighter.role === 'swordsman') {
              spawnSlashArc(fighter, cfg.skill2Range * 1.35, lockedYaw, 0x818cf8, 32, null);
              spawnSlashArc(fighter, cfg.skill2Range * 1.35, normalizeAngle(lockedYaw + 1.5), 0xc084fc, 22, null);
            }
            return;
          }

          if (kind === 'skillcc') {
            fighter.skillCcCd = 7.5;
            if (fighter.role === 'archer') {
              spawnProjectile({
                owner: fighter,
                mesh: createArrowMesh(0xfacc15, 1.2),
                pos: origin.clone().add(new THREE.Vector3(dirX * 1.0, 0, dirZ * 1.0)),
                yaw: lockedYaw,
                dirX,
                dirZ,
                speed: 29,
                damage: 20,
                maxDist: cfg.ccRange,
                radius: 0.85,
                stopOnFirstEnemy: true,
                ccType: 'stun',
                ccDuration: CC_DURATION
              });
            } else if (fighter.role === 'swordsman') {
              spawnSlashArc(fighter, cfg.ccRange * 2.0, lockedYaw, 0xfacc15, 24, 'stun');
            } else if (fighter.role === 'mage') {
              const targetCenter = customPos
                ? customPos.clone()
                : fighter.pos.clone().add(new THREE.Vector3(dirX * Math.min(18, cfg.ccRange), 0, dirZ * Math.min(18, cfg.ccRange)));
              resolveArenaAndObstacles(targetCenter, 0.5);
              const radius = 5.2;
              const ring = new THREE.Mesh(
                new THREE.RingGeometry(0.4, radius, 28),
                new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide, transparent: true, opacity: 0.65 })
              );
              ring.rotation.x = -Math.PI / 2;
              ring.position.set(targetCenter.x, 0.08, targetCenter.z);
              scene.add(ring);

              const disc = new THREE.Mesh(
                new THREE.CircleGeometry(radius, 28),
                new THREE.MeshBasicMaterial({ color: 0x7dd3fc, side: THREE.DoubleSide, transparent: true, opacity: 0.25 })
              );
              disc.rotation.x = -Math.PI / 2;
              disc.position.set(targetCenter.x, 0.06, targetCenter.z);
              scene.add(disc);

              state.aoeZones.push({
                owner: fighter,
                outerRing: ring,
                innerDisc: disc,
                x: targetCenter.x,
                z: targetCenter.z,
                radius,
                life: 1.5,
                maxLife: 1.5,
                ccType: 'slow',
                ccDuration: CC_DURATION,
                damage: 16
              });
              spawnMageSparkles(targetCenter.clone().add(new THREE.Vector3(0, 0.8, 0)), 8, 0x7dd3fc);
            }
            return;
          }

          if (kind === 'ult') {
            fighter.skillUltCd = ULT_COOLDOWN;
            if (fighter.role === 'archer') {
              const arrowCount = 50;
              for (let i = 0; i < arrowCount; i++) {
                const a = normalizeAngle(lockedYaw + (i / arrowCount) * Math.PI * 2);
                const dVec = yawToDirXZ(a);
                spawnProjectile({
                  owner: fighter,
                  mesh: createArrowMesh(0xfbbf24, 1.15),
                  pos: origin.clone().add(new THREE.Vector3(dVec.x * 1.1, 0, dVec.z * 1.1)),
                  yaw: a,
                  dirX: dVec.x,
                  dirZ: dVec.z,
                  speed: 13.5,
                  damage: 22,
                  maxDist: ARENA_RADIUS * 2.1,
                  radius: 0.78,
                  pierceObstacles: false,
                  pierceEnemies: false,
                  stopOnFirstEnemy: true
                });
              }
              spawnCallout(fighter.pos, 'BÃO TIỄN 360° (50 TIỄN)', '#facc15');
            } else if (fighter.role === 'swordsman') {
              const giantLen = ARENA_RADIUS * 2.0;
              const trailWidth = 4.8;
              const giantBlade = new THREE.Mesh(
                new THREE.BoxGeometry(1.1, 0.45, 7.5),
                new THREE.MeshStandardMaterial({
                  color: 0xfef08a,
                  emissive: 0xf97316,
                  emissiveIntensity: 1.8
                })
              );
              giantBlade.position.set(origin.x + dirX * 1.4, 1.5, origin.z + dirZ * 1.4);
              giantBlade.rotation.set(0, lockedYaw, 0);
              scene.add(giantBlade);

              state.specialFx.push({
                mesh: giantBlade,
                vx: dirX * 36,
                vz: dirZ * 36,
                life: 1.6,
                maxLife: 1.6,
                spin: 0
              });

              spawnFireTrailAlongLine(fighter, fighter.pos, lockedYaw, giantLen, trailWidth, 10.0, 9);
              for (const enemy of getAllEnemiesOf(fighter)) {
                const dLine = distToSegmentXZ(
                  enemy.pos.x,
                  enemy.pos.z,
                  fighter.pos.x,
                  fighter.pos.z,
                  fighter.pos.x + dirX * giantLen,
                  fighter.pos.z + dirZ * giantLen
                );
                if (dLine <= trailWidth * 0.65) {
                  applyDamage(fighter, enemy, 42, { color: 0xf97316 });
                }
              }
              spawnCallout(fighter.pos, 'TRẢM ĐỊA HỎA (10s)', '#fb923c');
            } else if (fighter.role === 'mage') {
              state.meteorRainTimer = 10.0;
              state.meteorRainOwner = fighter;
              spawnCallout(fighter.pos, 'MƯA LỬA TOÀN MAP (10s)', '#f97316');
              spawnMageSparkles(origin, 8, 0xf97316);
            }
          }
        }

        function beginCastWindup(fighter, kind, yaw, customPos = null) {
          if (!fighter || fighter.isDead || fighter.stunTimer > 0 || state.matchOver) return;
          if (fighter.windup.active) return;

          if (kind === 'basic' && fighter.attackCooldown > 0) return;
          if (kind === 'skill1' && fighter.skill1Cd > 0) return;
          if (kind === 'skill2' && fighter.skill2Cd > 0) return;
          if (kind === 'skillcc' && fighter.skillCcCd > 0) return;
          if (kind === 'ult' && fighter.skillUltCd > 0) return;

          const lockedYaw = normalizeAngle(yaw);
          fighter.yaw = lockedYaw;
          fighter.rig.root.rotation.y = lockedYaw;
          fighter.windup = {
            active: true,
            kind,
            timer: WINDUP_DURATION,
            maxTimer: WINDUP_DURATION,
            targetYaw: lockedYaw,
            customPos: customPos ? customPos.clone() : null
          };
        }

        function updateFighters(dt) {
          for (const f of state.allFighters) {
            if (!f || !f.rig) continue;

            if (f.invulnTimer > 0) f.invulnTimer = Math.max(0, f.invulnTimer - dt);
            if (f.immortalTimer > 0) f.immortalTimer = Math.max(0, f.immortalTimer - dt);
            if (f.attackCooldown > 0) f.attackCooldown = Math.max(0, f.attackCooldown - dt);
            if (f.skill1Cd > 0) f.skill1Cd = Math.max(0, f.skill1Cd - dt);
            if (f.skill2Cd > 0) f.skill2Cd = Math.max(0, f.skill2Cd - dt);
            if (f.skillCcCd > 0) f.skillCcCd = Math.max(0, f.skillCcCd - dt);
            if (f.skillUltCd > 0) f.skillUltCd = Math.max(0, f.skillUltCd - dt);
            if (f.blinkCd > 0) f.blinkCd = Math.max(0, f.blinkCd - dt);
            if (f.speedBuffTimer > 0) f.speedBuffTimer = Math.max(0, f.speedBuffTimer - dt);
            if (f.stunTimer > 0) f.stunTimer = Math.max(0, f.stunTimer - dt);
            if (f.slowTimer > 0) f.slowTimer = Math.max(0, f.slowTimer - dt);
            if (f.blindTimer > 0) f.blindTimer = Math.max(0, f.blindTimer - dt);
            if (f.bushRevealTimer > 0) f.bushRevealTimer = Math.max(0, f.bushRevealTimer - dt);
            if (f.aiThinkTimer > 0) f.aiThinkTimer = Math.max(0, f.aiThinkTimer - dt);
            if (f.aiSkillGlobalLock > 0) f.aiSkillGlobalLock = Math.max(0, f.aiSkillGlobalLock - dt);

            if (f.isDead) {
              if (f.lives > 0) {
                f.respawnTimer -= dt;
                if (f.respawnTimer <= 0) {
                  respawnFighterOnSpot(f);
                }
              }
              continue;
            }

            f.hidingInShelter = isInsideShelter(f.pos);
            f.inBush = getBushAt(f.pos);
            f.isStealthed = Boolean(f.inBush && f.bushRevealTimer <= 0);

            f.rig.root.traverse((obj) => {
              if (obj.isMesh && obj.material && obj !== f.rig.teamRing && obj !== f.rig.ccRing) {
                obj.material.transparent = true;
                obj.material.opacity = f.isStealthed ? 0.34 : f.invulnTimer > 0 ? 0.65 : 1.0;
              }
            });

            if (f.rig.ccRing) {
              const hasCc = f.stunTimer > 0 || f.slowTimer > 0 || f.blindTimer > 0;
              f.rig.ccRing.material.opacity = hasCc ? 0.85 : 0;
              if (f.stunTimer > 0) f.rig.ccRing.material.color.setHex(0xfacc15);
              else if (f.slowTimer > 0) f.rig.ccRing.material.color.setHex(0x38bdf8);
              else if (f.blindTimer > 0) f.rig.ccRing.material.color.setHex(0xfb7185);
            }

            if (f.windup.active) {
              f.windup.timer -= dt;
              const pullFactor = clamp(1 - f.windup.timer / Math.max(0.01, f.windup.maxTimer), 0, 1);
              // Giữ nguyên góc quay đã khóa suốt thời gian tụ chiêu 0.5s, không để hướng ngắm/hướng xoay bị lệch
              f.yaw = normalizeAngle(f.windup.targetYaw);
              f.rig.root.rotation.y = f.yaw;
              if (f.parts.rightArm) f.parts.rightArm.rotation.x = -1.25;
              if (f.parts.weapon) f.parts.weapon.rotation.x = -0.75;
              f.rig.bodyGroup.scale.set(1 + pullFactor * 0.12, 1 - pullFactor * 0.06, 1 + pullFactor * 0.12);

              if (f.windup.timer <= 0) {
                const kind = f.windup.kind;
                const yw = normalizeAngle(f.windup.targetYaw);
                const cp = f.windup.customPos;
                f.windup.active = false;
                f.rig.bodyGroup.scale.set(1, 1, 1);
                if (f.parts.rightArm) f.parts.rightArm.rotation.x = -0.45;
                if (f.parts.weapon) f.parts.weapon.rotation.x = 0;
                executeCast(f, kind, yw, cp);
              }
              resolveArenaAndObstacles(f.pos, 0.8);
              f.rig.root.position.copy(f.pos);
              f.rig.root.position.y = 0;
              continue;
            }

            let moveX = 0;
            let moveZ = 0;

            if (f.isPlayer && !state.matchOver) {
              const camForwardX = state.cam.lookAt.x - state.cam.pos.x;
              const camForwardZ = state.cam.lookAt.z - state.cam.pos.z;
              const fwdLen = Math.hypot(camForwardX, camForwardZ) || 1;
              const fwdX = camForwardX / fwdLen;
              const fwdZ = camForwardZ / fwdLen;
              const rightX = -fwdZ;
              const rightZ = fwdX;

              let kForward = 0;
              let kRight = 0;
              if (state.keys.has('KeyW') || state.keys.has('ArrowUp')) kForward += 1;
              if (state.keys.has('KeyS') || state.keys.has('ArrowDown')) kForward -= 1;
              if (state.keys.has('KeyD') || state.keys.has('ArrowRight')) kRight += 1;
              if (state.keys.has('KeyA') || state.keys.has('ArrowLeft')) kRight -= 1;

              if (kForward !== 0 || kRight !== 0) {
                const mag = Math.hypot(kRight, kForward) || 1;
                const nx = kRight / mag;
                const nz = kForward / mag;
                moveX = rightX * nx + fwdX * nz;
                moveZ = rightZ * nx + fwdZ * nz;
              } else if (state.joy.active) {
                const jRight = state.joy.dx;
                const jForward = -state.joy.dz;
                moveX = rightX * jRight + fwdX * jForward;
                moveZ = rightZ * jRight + fwdZ * jForward;
              }

              if (state.attackHeld && f.attackCooldown <= 0 && f.stunTimer <= 0 && !telegraph.active) {
                const nearEnemy = findNearestEnemyOf(f);
                const aimYaw = nearEnemy && canObserverSeeTarget(f, nearEnemy)
                  ? Math.atan2(nearEnemy.pos.x - f.pos.x, nearEnemy.pos.z - f.pos.z)
                  : f.yaw;
                beginCastWindup(f, 'basic', aimYaw, null);
              }
            } else if (!f.isPlayer && !state.matchOver) {
              const target = findNearestEnemyOf(f);
              if (target) {
                const dx = target.pos.x - f.pos.x;
                const dz = target.pos.z - f.pos.z;
                const dist = Math.hypot(dx, dz);
                const seesTarget = canObserverSeeTarget(f, target);

                if (seesTarget) {
                  f.aiLastKnownPos = target.pos.clone();
                }

                const isMelee = f.role === 'swordsman';
                const desiredDist = isMelee ? 3.2 : 16.0;

                if (seesTarget) {
                  if (dist > desiredDist + 1.5) {
                    moveX = dx / Math.max(0.001, dist);
                    moveZ = dz / Math.max(0.001, dist);
                  } else if (dist < desiredDist * 0.45 && !isMelee) {
                    moveX = -dx / Math.max(0.001, dist);
                    moveZ = -dz / Math.max(0.001, dist);
                  } else {
                    const strafeYaw = Math.atan2(dx, dz) + Math.PI * 0.5;
                    moveX = Math.sin(strafeYaw) * 0.55;
                    moveZ = Math.cos(strafeYaw) * 0.55;
                  }

                  const aimYaw = Math.atan2(dx, dz);
                  f.yaw = aimYaw;

                  if (f.aiThinkTimer <= 0 && f.stunTimer <= 0) {
                    f.aiThinkTimer = 1.15 + Math.random() * 0.45;
                    if (f.aiSkillGlobalLock <= 0 && dist <= f.cfg.skill1Range * 0.95) {
                      if (f.skillUltCd <= 0 && Math.random() < 0.25) {
                        beginCastWindup(f, 'ult', aimYaw, null);
                        f.aiSkillGlobalLock = 1.6;
                      } else if (f.skillCcCd <= 0 && dist <= f.cfg.ccRange * 1.15 && Math.random() < 0.42) {
                        beginCastWindup(f, 'skillcc', aimYaw, null);
                        f.aiSkillGlobalLock = 1.4;
                      } else if (f.skill1Cd <= 0 && Math.random() < 0.5) {
                        beginCastWindup(f, 'skill1', aimYaw, null);
                        f.aiSkillGlobalLock = 1.3;
                      } else if (f.skill2Cd <= 0 && Math.random() < 0.35) {
                        beginCastWindup(f, 'skill2', aimYaw, null);
                        f.aiSkillGlobalLock = 1.3;
                      } else if (f.attackCooldown <= 0 && dist <= f.cfg.basicRange) {
                        beginCastWindup(f, 'basic', aimYaw, null);
                      }
                    } else if (f.attackCooldown <= 0 && dist <= f.cfg.basicRange) {
                      beginCastWindup(f, 'basic', aimYaw, null);
                    }
                  }
                } else if (f.aiLastKnownPos) {
                  const ldx = f.aiLastKnownPos.x - f.pos.x;
                  const ldz = f.aiLastKnownPos.z - f.pos.z;
                  const ldist = Math.hypot(ldx, ldz);
                  if (ldist > 1.8) {
                    moveX = ldx / ldist;
                    moveZ = ldz / ldist;
                  } else {
                    f.aiLastKnownPos = null;
                  }
                } else {
                  const toCenterDist = Math.hypot(f.pos.x, f.pos.z);
                  if (toCenterDist > 26) {
                    moveX = -f.pos.x / toCenterDist;
                    moveZ = -f.pos.z / toCenterDist;
                  }
                }
              }
            }

            if (f.stunTimer <= 0) {
              const mag = Math.hypot(moveX, moveZ);
              if (mag > 0.01) {
                const mx = moveX / mag;
                const mz = moveZ / mag;
                let spd = f.cfg.moveSpeed;
                if (f.slowTimer > 0) spd *= 0.55;
                if (f.speedBuffTimer > 0) spd *= BLINK_SPEED_MULT;

                f.pos.x += mx * spd * dt;
                f.pos.z += mz * spd * dt;
                resolveArenaAndObstacles(f.pos, 0.8);

                const targetYaw = Math.atan2(mx, mz);
                f.yaw = normalizeAngle(f.yaw + normalizeAngle(targetYaw - f.yaw) * Math.min(1, dt * 12));

                f.animTime += dt * (spd * 1.15);
                const swing = Math.sin(f.animTime) * 0.65;
                if (f.parts.leftLeg) f.parts.leftLeg.rotation.x = swing;
                if (f.parts.rightLeg) f.parts.rightLeg.rotation.x = -swing;
                if (f.parts.leftArm) f.parts.leftArm.rotation.x = -swing * 0.6;
                if (f.parts.rightArm) f.parts.rightArm.rotation.x = swing * 0.5 - 0.35;
              } else {
                if (f.parts.leftLeg) f.parts.leftLeg.rotation.x = 0;
                if (f.parts.rightLeg) f.parts.rightLeg.rotation.x = 0;
              }
            }

            f.rig.root.position.copy(f.pos);
            f.rig.root.position.y = 0;
            f.rig.root.rotation.y = f.yaw;
          }
        }

        function updateCombatObjects(dt) {
          for (let i = state.projectiles.length - 1; i >= 0; i--) {
            const pr = state.projectiles[i];
            // Duy trì hướng di chuyển (dirX, dirZ) và hướng xoay mesh cố định theo hướng ngắm đã khóa
            const step = pr.speed * dt;
            pr.pos.x += pr.dirX * step;
            pr.pos.z += pr.dirZ * step;
            pr.traveled += step;
            pr.mesh.position.copy(pr.pos);
            pr.mesh.rotation.set(0, pr.yaw, 0);

            if (pr.isMage && Math.random() < dt * 12) {
              spawnMageSparkles(pr.pos, 1, 0xe879f9);
            }

            let expired = pr.traveled >= pr.maxDist || Math.hypot(pr.pos.x, pr.pos.z) >= ARENA_RADIUS;

            if (!expired && !pr.pierceObstacles && hitTreeTrunk(pr.pos)) {
              spawnBurst(pr.pos, 4, 0xfbbf24, 3.8);
              expired = true;
            }

            if (!expired) {
              for (const target of state.allFighters) {
                if (!target || target === pr.owner || target.isDead || target.lives <= 0) continue;
                if (pr.hitSet.has(target)) continue;
                const d = Math.hypot(target.pos.x - pr.pos.x, target.pos.z - pr.pos.z);
                if (d <= pr.radius + 0.85) {
                  pr.hitSet.add(target);
                  const currentDmg = pr.damage * Math.pow(pr.damageScaleOnHit, pr.hitSet.size - 1);
                  applyDamage(pr.owner, target, currentDmg, { color: pr.isMage ? 0xe879f9 : 0xfbbf24 });
                  if (pr.ccType) {
                    applyCrowdControl(pr.owner, target, pr.ccType, pr.ccDuration);
                  }
                  if (!pr.pierceEnemies || pr.stopOnFirstEnemy) {
                    expired = true;
                    break;
                  }
                }
              }
            }

            if (expired) {
              disposeObject3D(pr.mesh);
              state.projectiles.splice(i, 1);
            }
          }

          for (let i = state.slashArcs.length - 1; i >= 0; i--) {
            const sl = state.slashArcs[i];
            sl.life -= dt;
            const prog = 1 - clamp(sl.life / sl.maxLife, 0, 1);
            const sc = 0.7 + prog * 0.45;
            sl.mesh.scale.set(sc, sc, 1);
            sl.mesh.material.opacity = (1 - prog) * 0.75;
            if (sl.life <= 0) {
              disposeObject3D(sl.mesh);
              state.slashArcs.splice(i, 1);
            }
          }

          for (let i = state.aoeZones.length - 1; i >= 0; i--) {
            const z = state.aoeZones[i];
            z.life -= dt;
            for (const f of state.allFighters) {
              if (!f || f === z.owner || f.isDead || f.lives <= 0) continue;
              if (Math.hypot(f.pos.x - z.x, f.pos.z - z.z) <= z.radius + 0.6) {
                if (z.ccType) applyCrowdControl(z.owner, f, z.ccType, 0.45);
              }
            }
            const alpha = clamp(z.life / z.maxLife, 0, 1) * 0.65;
            z.outerRing.material.opacity = alpha;
            z.innerDisc.material.opacity = alpha * 0.4;
            if (z.life <= 0) {
              disposeObject3D(z.outerRing);
              disposeObject3D(z.innerDisc);
              state.aoeZones.splice(i, 1);
            }
          }

          for (let i = state.fireTrails.length - 1; i >= 0; i--) {
            const ft = state.fireTrails[i];
            ft.life -= dt;
            ft.tickTimer -= dt;
            ft.mesh.material.opacity = clamp(ft.life / ft.maxLife, 0, 1) * 0.34;
            if (ft.tickTimer <= 0) {
              ft.tickTimer = 0.5;
              for (const f of state.allFighters) {
                if (!f || f === ft.owner || f.isDead || f.lives <= 0) continue;
                const d = distToSegmentXZ(f.pos.x, f.pos.z, ft.ax, ft.az, ft.bx, ft.bz);
                if (d <= ft.halfWidth + 0.6) {
                  applyDamage(ft.owner, f, ft.tickDmg, { color: 0xf97316, showImmune: false });
                }
              }
            }
            if (ft.life <= 0) {
              disposeObject3D(ft.mesh);
              state.fireTrails.splice(i, 1);
            }
          }

          if (state.meteorRainTimer > 0 && state.meteorRainOwner) {
            state.meteorRainTimer -= dt;
            if (Math.random() < dt * 7.5 && state.meteorZones.length < 28) {
              spawnMeteorRainStrike(state.meteorRainOwner);
            }
          }

          for (let i = state.meteorZones.length - 1; i >= 0; i--) {
            const mz = state.meteorZones[i];
            if (!mz.exploded) {
              mz.fallTime -= dt;
              const p = 1 - clamp(mz.fallTime / 0.45, 0, 1);
              mz.mesh.position.y = (1 - p) * 18 + 0.5;
              if (mz.fallTime <= 0) {
                mz.exploded = true;
                mz.mesh.position.y = 0.12;
                mz.mesh.scale.set(1.3, 0.35, 1.3);
                mz.warnRing.material.color.setHex(0xef4444);
                for (const f of state.allFighters) {
                  if (!f || f === mz.owner || f.isDead || f.lives <= 0) continue;
                  if (Math.hypot(f.pos.x - mz.x, f.pos.z - mz.z) <= mz.radius + 0.6) {
                    applyDamage(mz.owner, f, 48, { color: 0xef4444, reduceInBushOrShelter: true });
                  }
                }
              }
            } else {
              mz.puddleLife -= dt;
              mz.tickTimer -= dt;
              if (mz.tickTimer <= 0) {
                mz.tickTimer = 0.6;
                for (const f of state.allFighters) {
                  if (!f || f === mz.owner || f.isDead || f.lives <= 0) continue;
                  if (Math.hypot(f.pos.x - mz.x, f.pos.z - mz.z) <= mz.radius + 0.5) {
                    applyDamage(mz.owner, f, 7, { color: 0xf97316, reduceInBushOrShelter: true, showImmune: false });
                  }
                }
              }
              if (mz.puddleLife <= 0) {
                disposeObject3D(mz.mesh);
                disposeObject3D(mz.warnRing);
                state.meteorZones.splice(i, 1);
              }
            }
          }

          for (let i = state.specialFx.length - 1; i >= 0; i--) {
            const fx = state.specialFx[i];
            fx.life -= dt;
            fx.mesh.position.x += fx.vx * dt;
            fx.mesh.position.z += fx.vz * dt;
            if (fx.spin) fx.mesh.rotation.y += fx.spin * dt;
            if (fx.life <= 0) {
              disposeObject3D(fx.mesh);
              state.specialFx.splice(i, 1);
            }
          }

          for (let i = state.particles.length - 1; i >= 0; i--) {
            const pt = state.particles[i];
            pt.life -= dt;
            pt.vel.y -= 12 * dt;
            pt.mesh.position.addScaledVector(pt.vel, dt);
            if (pt.mesh.position.y < 0.1) pt.mesh.position.y = 0.1;
            const sc = clamp(pt.life / pt.maxLife, 0.05, 1);
            pt.mesh.scale.setScalar(sc);
            if (pt.life <= 0) {
              disposeObject3D(pt.mesh);
              state.particles.splice(i, 1);
            }
          }

          for (let i = state.callouts.length - 1; i >= 0; i--) {
            const c = state.callouts[i];
            c.life -= dt;
            c.pos.y += 1.6 * dt;
            if (c.life <= 0) {
              if (c.el && c.el.parentNode) c.el.parentNode.removeChild(c.el);
              state.callouts.splice(i, 1);
              continue;
            }
            const proj = c.pos.clone().project(camera);
            if (proj.z > 1) {
              c.el.style.opacity = '0';
            } else {
              const sx = (proj.x * 0.5 + 0.5) * window.innerWidth;
              const sy = (-proj.y * 0.5 + 0.5) * window.innerHeight;
              c.el.style.left = `${sx}px`;
              c.el.style.top = `${sy}px`;
              c.el.style.opacity = `${clamp(c.life / (c.maxLife * 0.5), 0, 1)}`;
            }
          }
        }

        function updateCamera(dt) {
          const p = state.player;
          if (!p) return;

          if (!(state.cam.lookAt && typeof state.cam.lookAt.lerp === 'function')) {
            state.cam.lookAt = new THREE.Vector3(p.pos.x, 1.0, p.pos.z);
          }

          const targetLook = new THREE.Vector3(p.pos.x, 1.1, p.pos.z);
          state.cam.lookAt.lerp(targetLook, Math.min(1, dt * 10));

          const desiredPos = new THREE.Vector3();
          if (state.cameraMode === 'free3d') {
            const dist = state.cam.orbitDist || 44;
            const pitch = clamp(state.cam.orbitPitch || 0.68, 0.25, 1.25);
            const yaw = state.cam.orbitYaw || 0;
            const horiz = Math.cos(pitch) * dist;
            desiredPos.set(
              state.cam.lookAt.x + Math.sin(yaw) * horiz,
              state.cam.lookAt.y + Math.sin(pitch) * dist,
              state.cam.lookAt.z + Math.cos(yaw) * horiz
            );
          } else if (state.cameraMode === 'overview') {
            desiredPos.set(state.cam.lookAt.x, 54, state.cam.lookAt.z + 24);
          } else {
            const fwdX = Math.sin(p.yaw);
            const fwdZ = Math.cos(p.yaw);
            desiredPos.set(
              p.pos.x - fwdX * 15,
              p.pos.y + 8.2,
              p.pos.z - fwdZ * 15
            );
          }

          state.cam.pos.lerp(desiredPos, Math.min(1, dt * 8));
          camera.position.copy(state.cam.pos);
          camera.lookAt(state.cam.lookAt);
        }

        function setGameOverModalVisible(visible) {
          if (!ui.gameoverModal) return;
          if (visible) {
            ui.gameoverModal.classList.remove('hidden');
            ui.gameoverModal.classList.add('flex');
            ui.gameoverModal.style.display = 'flex';
          } else {
            ui.gameoverModal.classList.add('hidden');
            ui.gameoverModal.classList.remove('flex');
            ui.gameoverModal.style.display = 'none';
          }
        }

        function checkSurvivalWinner() {
          if (state.matchOver) return;
          const survivors = state.allFighters.filter((f) => f && f.lives > 0);
          const playerAliveLives = state.player && state.player.lives > 0;

          if (survivors.length <= 1 || !playerAliveLives) {
            state.matchOver = true;
            const winner = survivors[0] || state.enemy || state.player;
            const playerWon = Boolean(winner && winner === state.player && playerAliveLives);

            if (ui.gameoverIcon) ui.gameoverIcon.textContent = playerWon ? '🏆' : '💀';
            if (ui.gameoverTitle) ui.gameoverTitle.textContent = playerWon ? 'Chiến Thắng!' : 'Thất Bại!';
            if (ui.gameoverDesc) {
              ui.gameoverDesc.textContent = playerWon
                ? 'Bạn đã sống sót đến cuối cùng trong đấu trường sinh tồn!'
                : `${winner ? winner.displayName : 'Đối thủ'} đã giành chiến thắng chung cuộc.`;
            }
            setGameOverModalVisible(true);
          }
        }

        function updateHud(forceText = false) {
          const p = state.player;
          const e = state.enemy;
          const aliveCount = state.allFighters.filter((f) => f && f.lives > 0).length;
          if (ui.matchupSummary) {
            ui.matchupSummary.textContent = `Sinh Tồn (${aliveCount}/${state.allFighters.length} sống)`;
          }

          if (p) {
            const pct = clamp((p.hp / Math.max(1, p.maxHp)) * 100, 0, 100);
            if (ui.playerHpBar) ui.playerHpBar.style.width = `${pct}%`;
            if (ui.playerHpText) ui.playerHpText.textContent = `${Math.ceil(p.hp)}/${p.maxHp}`;
            if (ui.playerLives) ui.playerLives.textContent = '❤️'.repeat(p.lives) + '🖤'.repeat(Math.max(0, MAX_LIVES - p.lives));

            const tags = [];
            if (p.isStealthed) tags.push('<span class="px-1.5 py-0.5 rounded bg-emerald-500/25 text-emerald-200 text-[9px] font-bold">🌿 Ẩn</span>');
            if (p.hidingInShelter) tags.push('<span class="px-1.5 py-0.5 rounded bg-cyan-500/25 text-cyan-200 text-[9px] font-bold">🕳️ Hầm</span>');
            if (p.immortalTimer > 0) tags.push(`<span class="px-1.5 py-0.5 rounded bg-sky-500/30 text-sky-200 text-[9px] font-bold">🛡️ ${p.immortalTimer.toFixed(1)}s</span>`);
            if (p.stunTimer > 0) tags.push('<span class="px-1.5 py-0.5 rounded bg-amber-500/30 text-amber-200 text-[9px] font-bold">💫 Choáng</span>');
            if (p.slowTimer > 0) tags.push('<span class="px-1.5 py-0.5 rounded bg-blue-500/30 text-blue-200 text-[9px] font-bold">❄️ Chậm</span>');
            if (p.blindTimer > 0) tags.push('<span class="px-1.5 py-0.5 rounded bg-rose-500/30 text-rose-200 text-[9px] font-bold">🙈 Mù</span>');
            if (ui.playerStatusTags) ui.playerStatusTags.innerHTML = tags.join('');

            const setCdUi = (cd, maxCd, fillEl, txtEl) => {
              const ratio = maxCd > 0 ? clamp(cd / maxCd, 0, 1) : 0;
              if (fillEl) fillEl.style.height = `${ratio * 100}%`;
              if (txtEl && !forceText) {
                txtEl.textContent = cd > 0.05 ? `${cd.toFixed(1)}s` : '';
              }
            };

            setCdUi(p.attackCooldown, BASIC_ATTACK_COOLDOWN, ui.attackCdFill, null);
            setCdUi(p.skill1Cd, 5.0, ui.skill1CdFill, ui.skill1CdText);
            setCdUi(p.skill2Cd, 6.5, ui.skill2CdFill, ui.skill2CdText);
            setCdUi(p.skillCcCd, 7.5, ui.skillccCdFill, ui.skillccCdText);
            setCdUi(p.skillUltCd, ULT_COOLDOWN, ui.skillultCdFill, ui.skillultCdText);

            if (ui.blinkCooldownFill) {
              ui.blinkCooldownFill.style.width = `${clamp(p.blinkCd / BLINK_COOLDOWN, 0, 1) * 100}%`;
            }
            if (ui.blinkLabel) {
              ui.blinkLabel.textContent = p.blinkCd > 0.05 ? `${p.blinkCd.toFixed(1)}s` : 'TỐC BIẾN';
            }
          }

          if (e) {
            const epct = clamp((e.hp / Math.max(1, e.maxHp)) * 100, 0, 100);
            if (ui.enemyHpBar) ui.enemyHpBar.style.width = `${epct}%`;
            if (ui.enemyHpText) ui.enemyHpText.textContent = `${Math.ceil(e.hp)}/${e.maxHp}`;
            if (ui.enemyLives) ui.enemyLives.textContent = '❤️'.repeat(e.lives) + '🖤'.repeat(Math.max(0, MAX_LIVES - e.lives));
          }
