          if (rNow > maxR && rNow > 0.0001) {
            pos.x = (pos.x / rNow) * maxR;
            pos.z = (pos.z / rNow) * maxR;
          }

          for (const t of TREE_OBSTACLES) {
            const dx = pos.x - t.x;
            const dz = pos.z - t.z;
            const dist = Math.hypot(dx, dz);
            const minDist = t.r + entityRadius;
            if (dist < minDist) {
              if (dist > 0.0001) {
                pos.x = t.x + (dx / dist) * minDist;
                pos.z = t.z + (dz / dist) * minDist;
              } else {
                pos.x = t.x + minDist;
              }
            }
          }
          pos.y = 0;
        }

